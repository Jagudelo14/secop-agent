# ### Archivo: .env.example ###
# Autor: Juan Camilo Agudelo (Jagudelo14)
# Correo: camiloagu1401@gmail.com
# Fecha: 2026-11-16
# Descripción: Variables de entorno de ejemplo, copiar a .env

# ### Claude ###
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 por defecto, claude-haiku-5-5 opción barata
MODEL=claude-sonnet-5-5
EFFORT=medium
# ### Proveedor ###
# gemini gratis o anthropic
PROVEEDOR=gemini

# ### Gemini ###
# llave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODELGEMINI=gemini-3.5-flash-lite
# si el principal está saturado, en orden
GEMINI_RESPALDO=gemini-3.1-flash-lite
# peticiones por minuto nivel gratuito
GEMINI_RPM=5
# usd por millón, solo para estimar
GEMINI_PRECIO_ENTRADA=
GEMINI_PRECIO_SALIDA=

# ### datos.gov.co ###
# token gratis en https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# ### Caché y demo ###
SECOP_CACHE_DIR=.cache/socrata
SECOP_CACHE_HORAS=24
# 1 = solo caché, sin red
SECOP_MODO_DEMO=0
# 1 = ocultar cédulas de personas naturales
SECOP_OCULTAR_DOCUMENTOS=0