# Descripción: Variables de entorno de ejemplo, copiar a .env

# ### Claude ###
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 por defecto, claude-haiku-5-5 opción barata
MODEL=claude-sonnet-5-5
EFFORT=medium

# ### datos.gov.co ###
# token gratis en https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# ### Caché y demo ###
SECOP_CACHE_DIR=.cache/socrata
SECOP_CACHE_HORAS=24
# 1 = solo caché, sin red
SECOP_MODO_DEMO=0
# 1 = ocultar cédulas de personas naturales
SECOP_OCULTAR_DOCUMENTOS=0
